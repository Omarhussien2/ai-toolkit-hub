{
  "name": "mytoolkit",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/web",
    "apps/extension"
  ],
  "scripts": {
    "dev": "npm --workspace apps/web run dev",
    "build": "npm --workspace apps/web run build",
    "lint": "npm --workspace apps/web run lint",
    "prepare:data": "node scripts/prepare-data.mjs",
    "extension:dev": "npm --workspace apps/extension run dev",
    "extension:build": "npm --workspace apps/extension run build"
  }
}
